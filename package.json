{
  "name": "vimex",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "bun run apps/cli/src/main.ts",
    "start": "bun run apps/cli/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run typecheck && bun run boundaries && bun run docs:check && bun test",
    "generate:codex": "bun run scripts/generate-codex-types.ts",
    "boundaries": "bun run scripts/verify-boundaries.ts",
    "test:unit": "bun test packages/conversation packages/composer packages/interaction packages/transcript packages/approvals packages/workbench packages/platform-node apps/tui/src/cli-options.test.ts apps/tui/src/lifecycle.test.ts apps/cli packages/distribution",
    "test:integration": "bun test tests/integration plugins/herdr",
    "test:contract": "bun test tests/contract",
    "test:ui": "bun test packages/ui-opentui-react",
    "test:e2e": "bun test tests/terminal",
    "benchmark:transcript": "bun scripts/benchmark-transcript-scroll.tsx",
    "benchmark:transcript-windowing": "bun scripts/benchmark-transcript-windowing.tsx",
    "benchmark:transcript-window-planner": "bun scripts/benchmark-transcript-window-planner.ts",
    "benchmark:transcript-windowing:native": "VIMEX_WINDOWING_NATIVE_BASELINE=1 VIMEX_WINDOWING_GEOMETRY_BASELINE=1 VIMEX_WINDOWING_SIZES=100 VIMEX_WINDOWING_VIEWPORTS=80x24 bun scripts/benchmark-transcript-windowing.tsx",
    "benchmark:transcript-windowing:input": "bun scripts/benchmark-transcript-windowing-input.tsx",
    "docs:generate": "bun scripts/generate-manual.ts",
    "docs:check": "bun scripts/generate-manual.ts --check",
    "build": "bun scripts/release/build.ts",
    "package": "bun scripts/release/package.ts",
    "release:manifest": "bun scripts/release/manifest.ts",
    "release:formula": "bun scripts/release/update-homebrew.ts",
    "prepare": "bun --bun run husky",
    "format": "bun --bun run prettier --write .",
    "format:check": "bun --bun run prettier --check .",
    "lint:staged": "bun --bun run lint-staged",
    "commitlint": "bun --bun node_modules/@commitlint/cli/cli.js"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "@opentui/keymap": "0.5.11",
    "@opentui/react": "0.5.11",
    "react": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "packageManager": "bun@1.3.6",
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,md,mdx,yml,yaml,css,scss,html}": "bun --bun run prettier --write"
  }
}
